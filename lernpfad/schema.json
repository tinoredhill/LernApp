{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "Lernapp Fragen",
 "type": "object",
 "required": [
  "version",
  "subjects"
 ],
 "properties": {
  "version": {
   "type": "integer"
  },
  "subjects": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "id",
     "name",
     "short",
     "color",
     "icon",
     "topics"
    ],
    "properties": {
     "id": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "short": {
      "type": "string"
     },
     "color": {
      "type": "string",
      "pattern": "^#[0-9a-fA-F]{6}$"
     },
     "icon": {
      "type": "string"
     },
     "topics": {
      "type": "array",
      "minItems": 0,
      "items": {
       "type": "object",
       "required": [
        "id",
        "name",
        "goals",
        "questions"
       ],
       "properties": {
        "id": {
         "type": "string"
        },
        "name": {
         "type": "string"
        },
        "goals": {
         "type": "object",
         "additionalProperties": {
          "type": "string"
         }
        },
        "questions": {
         "type": "array",
         "minItems": 0,
         "items": {
          "type": "object",
          "required": [
           "id",
           "goal",
           "level",
           "type",
           "prompt",
           "explanation"
          ],
          "properties": {
           "id": {
            "type": "string"
           },
           "goal": {
            "type": "integer"
           },
           "level": {
            "enum": [
             "G",
             "E"
            ]
           },
           "type": {
            "enum": [
             "mc",
             "tf",
             "num",
             "order",
             "match",
             "cloze"
            ]
           },
           "prompt": {
            "type": "string"
           },
           "options": {
            "type": "array",
            "items": {
             "type": "string"
            },
            "minItems": 2
           },
           "answer": {},
           "tolerance": {
            "type": "number",
            "minimum": 0
           },
           "unit": {
            "type": "string"
           },
           "image": {},
           "explanation": {
            "type": "string"
           },
           "items": {
            "type": "array",
            "items": {
             "type": "string"
            },
            "minItems": 3
           },
           "pairs": {
            "type": "array",
            "items": {
             "type": "array",
             "items": {
              "type": "string"
             }
            },
            "minItems": 3
           },
           "text": {
            "type": "string"
           },
           "gaps": {
            "type": "array",
            "minItems": 1,
            "items": {
             "type": "object"
            }
           }
          },
          "additionalProperties": false
         }
        },
        "eOnly": {
         "type": "array",
         "items": {
          "type": "integer"
         }
        }
       }
      }
     }
    }
   }
  }
 }
}